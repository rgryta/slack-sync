# Copy to `.env` next to the compose file and fill in. Never commit the filled copy.

# --- database ---------------------------------------------------------------
# Set when the roles were created by deploy/provision-slack-db.sql. The ingester
# owns the schema; the MCP role reads it and can write only the alias tables.
SLACK_INGEST_DB_PASSWORD=
SLACK_MCP_DB_PASSWORD=

# --- Slack session credentials, per ingester account -------------------------
# There is no Slack app and no bot token: the ingester borrows an already
# authenticated browser session. Both values come from a signed-in Slack client
# and both expire — see "when the token dies" below.
#
# To extract them from a desktop/web Slack that is already logged in:
#   1. Open the workspace in a browser, open DevTools.
#   2. Console:  JSON.parse(localStorage.localConfig_v2).teams  → find your team →
#      its `token` field is the `xoxc-…` value.
#   3. Application → Cookies → https://app.slack.com → copy the value of the `d`
#      cookie. That is the `xoxd-…` value; paste it exactly as shown, including
#      any percent-encoding.
#
# When the token dies, the `slack-status` MCP tool reports the account's last auth error
# and the stored data stops advancing. Repeat the two steps above, replace the
# values here, and restart only the affected ingester container. Nothing is lost:
# polling resumes from the stored cursor.
SLACK_WORK_XOXC=
SLACK_WORK_XOXD=

# --- MCP server ---------------------------------------------------------------
# `Host` headers the MCP endpoint will answer, comma separated: rmcp's guard against
# DNS rebinding. **Unset means loopback only** (`localhost,127.0.0.1,::1`), which
# fails closed — MCPHub addresses this server by container name, so leaving it unset
# answers every tool call with 403 and nothing in the logs names the header. There is
# deliberately no way to spell "allow everything".
SLACK_MCP_ALLOWED_HOSTS=slack-mcp

# --- optional per-ingester tuning (defaults shown) ---------------------------
# SLACK_SCOPE_CHANNELS=general,general-dev   channels kept in full, comma separated
# SLACK_POLL_INTERVAL=120                  seconds between poll passes
# SLACK_REACTION_WINDOW=7                  days of history re-read for reactions
# SLACK_RATE_LIMIT_RPS=0.8                 requests/second toward Slack
# SLACK_RATE_LIMIT_BURST=5
# SLACK_BACKFILL_ENABLED=true              crawl history older than the first poll
# SLACK_LOG_LEVEL=INFO
